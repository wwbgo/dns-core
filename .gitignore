## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Claude Code local settings
.claude/settings.local.json

# Others
appsettings.Development.json

# 测试数据
test-data/

# 临时测试项目
tests/PersistenceTest.cs
tests/PersistenceTest/

# 持久化数据文件
data/
# 但保留占位文件：compose 以 bind mount 挂载 ./data，
# Podman 不会自动创建缺失的挂载源目录（Docker 会），
# 目录不存在时容器直接创建失败。
!data/
data/*
!data/.gitkeep
*.db
*.litedb
# 不带斜杠，因此匹配任意层级：以 dotnet run 启动时数据会落在
# src/DnsCore/data/ 下，而上面的 data/* 只作用于仓库根目录
dns-records.json
upstream-settings.json
